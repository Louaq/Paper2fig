# Copy to .env and change every secret before exposing the service.
COMPOSE_PROJECT_NAME=paper2fig

# Web port on the host. Put a TLS reverse proxy in front for production.
HTTP_PORT=8080

# Public URL of the site, used for uploaded file URLs.
PUBLIC_BASE_URL=http://localhost:8080

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-yudao-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# Meilisearch master key (>= 16 chars; use a random hex string)
MEILI_MASTER_KEY=change-me-meili-master-key-0123456789abcdef

# Backend JVM
JAVA_OPTS=-Xmx512m -XX:MaxMetaspaceSize=256m -XX:+UseSerialGC
